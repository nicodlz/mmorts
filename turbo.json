{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "VITE_COLYSEUS_URL",
        "VITE_SERVER_URL",
        "VITE_E2E"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "VITE_COLYSEUS_URL",
        "VITE_SERVER_URL",
        "PORT",
        "HOST",
        "MAP_PATH",
        "ALLOWED_ORIGINS"
      ]
    },
    "dev:prod": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV"
  ]
}
