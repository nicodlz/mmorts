{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --require ts-node/register/transpile-only src/index.ts",
    "dev:prod": "cross-env NODE_ENV=production node --watch --require ts-node/register/transpile-only src/index.ts",
    "dev:prod:windows": "pnpm dev:prod",
    "build": "tsc && node scripts/copy-map.cjs",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "node --test --require ts-node/register test/*.test.ts",
    "benchmark": "ts-node scripts/benchmark.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.0",
    "@colyseus/monitor": "^0.17.0",
    "@colyseus/schema": "^4.0.0",
    "@colyseus/ws-transport": "^0.17.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "easystarjs": "^0.4.4",
    "express": "^4.22.3",
    "rbush": "^3.0.1",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.0",
    "@repo/eslint-config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/rbush": "^3.0.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
